{
  "name": "dsh-promptwall",
  "description": "Local prompt-injection and secret-exfiltration firewall for DeepSeek Harness",
  "version": "0.1.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chhlafiu4312/promptwall.git"
  },
  "homepage": "https://github.com/Chhlafiu4312/promptwall#readme",
  "bugs": {
    "url": "https://github.com/Chhlafiu4312/promptwall/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run",
    "snapshots:update": "node scripts/update-snapshots.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "prepare": "node scripts/prepare.mjs",
    "extract:patch": "node scripts/extract-patch.mjs",
    "patch:host": "bash scripts/patch.sh"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "promptwall": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./scanner": {
      "types": "./lib/types/scanner.d.ts",
      "default": "./lib/scanner.js"
    },
    "./secrets": {
      "types": "./lib/types/secrets.d.ts",
      "default": "./lib/secrets.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/cli.js",
    "lib/config.js",
    "lib/policy.js",
    "lib/runtime.js",
    "lib/scanner.js",
    "lib/secrets.js",
    "lib/tool.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-injection",
    "agent-security",
    "data-loss-prevention"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.4 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1-rc.4",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
